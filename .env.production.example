# Copia este archivo a .env.production y reemplaza cada valor sensible.
# No guardes .env.production en Git.
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=ecobazar
POSTGRES_USER=ecobazar_admin
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
IDENTITY_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
CATALOG_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
CART_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
ORDER_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
PAYMENT_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
MODERATION_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE

RABBITMQ_DEFAULT_USER=ecobazar
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_A_LONG_RANDOM_VALUE
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_A_LONG_RANDOM_VALUE
RATE_LIMIT_HASH_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE

# URLs internas con las contraseñas URL-encoded.
IDENTITY_DATABASE_URL=postgres://ecobazar_identity:REPLACE_WITH_PASSWORD@postgres:5432/ecobazar
CATALOG_DATABASE_URL=postgres://ecobazar_catalog:REPLACE_WITH_PASSWORD@postgres:5432/ecobazar
CART_DATABASE_URL=postgres://ecobazar_cart:REPLACE_WITH_PASSWORD@postgres:5432/ecobazar
ORDER_DATABASE_URL=postgres://ecobazar_ordering:REPLACE_WITH_PASSWORD@postgres:5432/ecobazar
PAYMENT_DATABASE_URL=postgres://ecobazar_payment:REPLACE_WITH_PASSWORD@postgres:5432/ecobazar
MODERATION_DATABASE_URL=postgres://ecobazar_moderation:REPLACE_WITH_PASSWORD@postgres:5432/ecobazar

SUPABASE_URL=https://project.supabase.co
SUPABASE_SERVER_KEY=REPLACE_WITH_SUPABASE_SERVER_KEY
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="EcoBazar <no-reply@example.com>"

STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
GOOGLE_CLIENT_ID=

# Valores que se incrustan en el frontend durante el build.
LEGAL_COMPANY_NAME=REPLACE_WITH_LEGAL_ENTITY
LEGAL_ADDRESS=REPLACE_WITH_LEGAL_ADDRESS
PRIVACY_EMAIL=contacto@eco-bazar.store
SUPPORT_EMAIL=contacto@eco-bazar.store
SUPPORT_PHONE=

# Restic/S3 (el archivo de contraseña debe vivir fuera del repositorio).
RESTIC_REPOSITORY=s3:https://s3.example.com/ecobazar-production
RESTIC_PASSWORD_FILE=/etc/ecobazar/restic-password
AWS_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_S3_ENDPOINT=https://s3.example.com
