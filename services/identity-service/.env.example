NODE_ENV=development
PORT=4001
DATABASE_URL=postgres://ecobazar_identity:identity_dev@localhost:5432/bd_EcoBazar
RABBITMQ_URL=amqp://ecobazar:ecobazar_dev@localhost:5672
JWT_PRIVATE_KEY_PATH=../../.secrets/jwt-private.pem
# Para desarrollo fuera de Docker también puede usarse un PEM con saltos escapados:
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
JWT_EXPIRES_IN=7d
JWT_ISSUER=ecobazar-identity
JWT_AUDIENCE=ecobazar-api
COOKIE_NAME=ecobazar_session
GOOGLE_CLIENT_ID=
# Tokens diferentes, separados por coma, para servicios autorizados.
INTERNAL_SERVICE_TOKENS=change_this_internal_token_32_chars
# Compatibilidad local si sólo se configura un consumidor:
# INTERNAL_SERVICE_TOKEN=change_this_internal_token_32_chars
OUTBOX_INTERVAL_MS=1000
RATE_LIMIT_HASH_KEY=change_this_rate_limit_hash_key_32_chars
RATE_LIMIT_MUTATION_MAX=120
RATE_LIMIT_MUTATION_WINDOW_MS=3600000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
GOOGLE_RATE_LIMIT_MAX=20
GOOGLE_RATE_LIMIT_WINDOW_MS=3600000
PRIVACY_RATE_LIMIT_MAX=6
PRIVACY_RATE_LIMIT_WINDOW_MS=86400000
CATALOG_SERVICE_URL=http://localhost:4002
CART_SERVICE_URL=http://localhost:4003
ORDER_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005
MODERATION_SERVICE_URL=http://localhost:4006
PRIVACY_WORKER_INTERVAL_MS=5000
PRIVACY_REQUEST_TIMEOUT_MS=5000
PRIVACY_RETENTION_DAYS=365
SUPABASE_URL=
SUPABASE_SERVER_KEY=
SUPABASE_AVATAR_BUCKET=avatars
AVATAR_MAX_INPUT_BYTES=5242880
AVATAR_MAX_OUTPUT_BYTES=307200
AVATAR_OUTPUT_SIZE=256
AVATAR_MAX_PIXELS=16000000
AVATAR_RATE_LIMIT_MAX=10
AVATAR_RATE_LIMIT_WINDOW_MS=3600000
